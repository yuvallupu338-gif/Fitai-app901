# ==========================================================
#  יופי – משתני סביבה
#  העתיקו קובץ זה אל ‎.env.local‎ ומלאו את הערכים האמיתיים.
#  לעולם אין להעלות את ‎.env.local‎ ל־git.
# ==========================================================

# ----------------------------------------------------------
# Supabase – מתוך Project Settings → API
# ----------------------------------------------------------

# כתובת הפרויקט. חשוף לדפדפן (בטוח).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# מפתח anon / publishable. חשוף לדפדפן (בטוח) – מוגן על ידי RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# מפתח service_role. **סודי!** שרת בלבד. עוקף RLS.
# אין להוסיף לו קידומת NEXT_PUBLIC ואין להשתמש בו בקוד לקוח.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# ה־JWT Secret של הפרויקט (Project Settings → API → JWT Settings → JWT Secret).
# **סודי!** משמש לחתימת אסימוני גישה למשתמשים שלנו כדי ש־RLS ו־Realtime יאכפו
# את ההרשאות גם כשמערכת האימות היא שם משתמש + סיסמה ולא Supabase Auth.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# חיבור ישיר למסד הנתונים – נדרש רק להרצת סקריפטי המיגרציה והזריעה
# (Project Settings → Database → Connection string → URI, עם הסיסמה שלכם).
# **סודי!**
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------
# אבטחת האפליקציה
# ----------------------------------------------------------

# מפתח לחתימת עוגיות ההתחברות. **סודי!**
# ליצירה: openssl rand -base64 48
AUTH_SECRET=change-me-openssl-rand-base64-48

# כתובת הבסיס הציבורית של האתר (משמשת לקישורים ולשיתופים).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------
# Push Notifications (רשות) – VAPID
# ליצירה: npx web-push generate-vapid-keys
# ----------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------
# ניהול
# ----------------------------------------------------------

# שם המשתמש שיקבל אוטומטית הרשאת מנהל בעת ההרשמה (רשות).
# אם ריק – יש להגדיר מנהל ידנית ב־SQL (ראו README).
ADMIN_BOOTSTRAP_USERNAME=
