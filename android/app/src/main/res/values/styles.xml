<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The near-black the app itself paints, so the launch window and the
       system bars match the first frame instead of flashing white. -->
  <style name="Theme.FitAI" parent="Theme.AppCompat.NoActionBar">
    <item name="android:windowBackground">@color/ground</item>
    <item name="android:statusBarColor">@color/ground</item>
    <item name="android:navigationBarColor">@color/ground</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
</resources>
